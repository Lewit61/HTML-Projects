<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lewit61 Code Box</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: 'Montserrat', sans-serif;
            background-color: transparent;
            overflow: hidden;
        }

        .embed-container {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            background: rgba(30, 30, 30, 0.75);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        }

        .header-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: rgba(20, 20, 20, 0.4);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
            z-index: 2;
        }

        .embed-title {
            color: #e8eaed;
            font-weight: 600;
            font-size: 14px;
        }

        .code-box-wrapper {
            flex: 1;
            position: relative;
            overflow: hidden;
            padding: 8px;
        }

        .code-box {
            width: 100%;
            height: 100%;
            overflow: auto;
            padding: 12px;
            color: #d4d4d4;
            font-family: 'JetBrains Mono', monospace;
            font-size: 14px;
            line-height: 1.5;
            white-space: pre;
        }

        .code-box::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .code-box::-webkit-scrollbar-track {
            background: transparent;
        }

        .code-box::-webkit-scrollbar-thumb {
            background: rgba(95, 99, 104, 0.5);
            border-radius: 4px;
        }

        .code-box::-webkit-scrollbar-thumb:hover {
            background: rgba(128, 134, 139, 0.8);
        }

        .copy-btn {
            background: rgba(255, 255, 255, 0.1);
            color: #e8eaed;
            border: none;
            border-radius: 6px;
            padding: 6px 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: 'Montserrat', sans-serif;
            font-size: 13px;
            font-weight: 500;
            transition: background 0.3s ease, width 0.3s ease, transform 0.2s ease;
            overflow: hidden;
            white-space: nowrap;
        }

        .copy-btn:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .copy-btn.copied {
            background: #2ea043;
            color: #ffffff;
        }

        .icon-container {
            position: relative;
            width: 20px;
            height: 20px;
            display: inline-block;
        }

        .material-symbols-rounded {
            position: absolute;
            top: 0;
            left: 0;
            font-size: 20px;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .icon-copy {
            opacity: 1;
            transform: scale(1);
        }

        .icon-check {
            opacity: 0;
            transform: scale(0.5);
        }

        .copy-btn.copied .icon-copy {
            opacity: 0;
            transform: scale(0.5);
        }

        .copy-btn.copied .icon-check {
            opacity: 1;
            transform: scale(1);
        }

        .btn-text {
            display: inline-block;
        }
    </style>
</head>
<body>

    <div class="embed-container">
        <div class="header-bar">
            <span class="embed-title">Code</span>
            <button class="copy-btn" id="copyBtn" title="Copy code">
                <span class="icon-container">
                    <span class="material-symbols-rounded icon-copy">content_copy</span>
                    <span class="material-symbols-rounded icon-check">check</span>
                </span>
                <span class="btn-text" id="btnText">Copy</span>
            </button>
        </div>
        <div class="code-box-wrapper">
            <div class="code-box" id="codeBox">Loading...</div>
        </div>
    </div>

    <script>
        const fileUrl = "REPLACE THIS WITH YOUR URL";
        const codeBox = document.getElementById('codeBox');
        const copyBtn = document.getElementById('copyBtn');
        const btnText = document.getElementById('btnText');

        async function fetchCode() {
            try {
                const response = await fetch(fileUrl);
                if (!response.ok) throw new Error('Failed to fetch');
                const text = await response.text();
                codeBox.textContent = text;
            } catch (error) {
                codeBox.textContent = "Error loading code from GitHub.";
            }
        }

        copyBtn.addEventListener('click', () => {
            const textToCopy = codeBox.textContent;
            navigator.clipboard.writeText(textToCopy).then(() => {
                copyBtn.classList.add('copied');
                btnText.textContent = 'Copied';

                setTimeout(() => {
                    copyBtn.classList.remove('copied');
                    btnText.textContent = 'Copy';
                }, 2000);
            });
        });

        fetchCode();
    </script>

</body>
</html>
